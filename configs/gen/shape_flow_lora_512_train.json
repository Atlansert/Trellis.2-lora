  "trainer": {
    "name": "ImageConditionedSparseFlowMatchingCFGTrainer",
    "args": {
      "max_steps": 200000,
      "batch_size_per_gpu": 4,
      "batch_split": 2,
      "optimizer": {
        "name": "AdamW",
        "args": {
          "lr": 0.0001,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.95
          ],
          "eps": 1e-08
        }
      },
      "ema_rate": [
        0.9999
      ],
      "mix_precision_mode": "amp",
      "mix_precision_dtype": "bfloat16",
      "elastic": {
        "name": "LinearMemoryController",
        "args": {
          "target_ratio": 0.75,
          "max_mem_ratio_start": 0.25
        }
      },
      "grad_clip": {
        "name": "AdaptiveGradClipper",
        "args": {
          "max_norm": 1.0,
          "clip_percentile": 95
        }
      },
      "i_log": 50,
      "i_sample": 2000,
      "i_save": 10000,
      "p_uncond": 0.1,
      "t_schedule": {
        "name": "logitNormal",
        "args": {
          "mean": 1.0,
          "std": 1.0
        }
      },
      "sigma_min": 1e-05,
      "image_cond_model": {
        "name": "DinoV3FeatureExtractor",
        "args": {
          "model_name": "./dinov3",
          "image_size": 512
        }
      }
    }
  }
