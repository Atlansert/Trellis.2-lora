{
  "models": {
    "denoiser": {
      "name": "ElasticSLatFlowModel",
      "args": {
        "resolution": 32,
        "in_channels": 32,
        "out_channels": 32,
        "model_channels": 1536,
        "cond_channels": 1024,
        "num_blocks": 30,
        "num_heads": 12,
        "mlp_ratio": 5.3334,
        "pe_mode": "rope",
        "share_mod": true,
        "initialization": "scaled",
        "qk_rms_norm": true,
        "qk_rms_norm_cross": true
      }
    }
  },
  "pretrained": {
    "denoiser": "checkpoints/ckpts/slat_flow_img2shape_dit_1_3B_512_bf16.safetensors"
  },
  "lora": {
    "enabled": true,
    "models": [
      "denoiser"
    ],
    "rank": 8,
    "alpha": 8.0,
    "dropout": 0.0,
    "targets": [
      "self_attn.to_qkv",
      "self_attn.to_out",
      "cross_attn.to_q",
      "cross_attn.to_kv",
      "cross_attn.to_out"
    ]
  },
  "dataset": {
    "name": "ImageConditionedSLatShape",
    "args": {
      "resolution": 512,
      "image_size": 512,
      "real_view_prob": 0.75,
      "min_aesthetic_score": 4.5,
      "max_tokens": 8192,
