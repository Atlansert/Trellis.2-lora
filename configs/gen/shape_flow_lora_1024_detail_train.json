{
    "models": {
        "denoiser": {
            "name": "ElasticSLatFlowModel",
            "args": {
                "resolution": 64,
                "in_channels": 32,
                "out_channels": 32,
                "model_channels": 1536,
                "cond_channels": 1024,
                "num_blocks": 30,
                "num_heads": 12,
                "mlp_ratio": 5.3334,
                "pe_mode": "rope",
                "share_mod": true,
                "initialization": "scaled",
                "qk_rms_norm": true,
                "qk_rms_norm_cross": true
            }
        }
    },
    "pretrained": {
        "denoiser": "checkpoints/ckpts/slat_flow_img2shape_dit_1_3B_1024_bf16.pt"
    },
    "lora": {
        "enabled": true,
        "models": ["denoiser"],
        "rank": 16,
        "alpha": 16.0,
        "dropout": 0.0,
        "targets": [
            "self_attn.to_qkv",
            "self_attn.to_out",
            "cross_attn.to_q",
            "cross_attn.to_kv",
            "cross_attn.to_out",
            "adaLN_modulation.1",
            "t_embedder.mlp.0",
            "t_embedder.mlp.2"
        ]
    },
    "dataset": {
        "name": "ImageConditionedSLatShape",
        "args": {
            "resolution": 1024,
            "image_size": 1024,
            "real_view_prob": 0.75,
            "min_aesthetic_score": 4.5,
            "max_tokens": 32768,
            "normalization": {
                "mean": [0.781296, 0.018091, -0.495192, -0.558457, 1.060530, 0.093252, 1.518149, -0.933218, -0.732996, 2.604095, -0.118341, -2.143904, 0.495076, -2.179512, -2.130751, -0.996944, 0.261421, -2.217463, 1.260067, -0.150213, 3.790713, 1.481266, -1.046058, -1.523667, -0.059621, 2.220780, 1.621212, 0.877230, 0.567247, -3.175944, -3.186688, 1.578665],
                "std": [5.972266, 4.706852, 5.445010, 5.209927, 5.320220, 4.547237, 5.020802, 5.444004, 5.226681, 5.683095, 4.831436, 5.286469, 5.652043, 5.367606, 5.525084, 4.730578, 4.805265, 5.124013, 5.530808, 5.619001, 5.103930, 5.417670, 5.269677, 5.547194, 5.634698, 5.235274, 6.110351, 5.511298, 6.237273, 4.879207, 5.347008, 5.405691]
            },
            "pretrained_slat_dec": "checkpoints/ckpts/shape_dec_next_dc_f16c32_fp16"
        }
    },
    "trainer": {
        "name": "ImageConditionedSparseFlowMatchingCFGTrainer",
        "args": {
            "max_steps": 12000,
            "batch_size_per_gpu": 2,
            "batch_split": 1,
            "optimizer": {"name": "AdamW", "args": {"lr": 0.00005, "weight_decay": 0.0, "betas": [0.9, 0.95], "eps": 1e-8}},
            "ema_rate": [0.999],
            "mix_precision_mode": "amp",
            "mix_precision_dtype": "bfloat16",
            "elastic": {"name": "LinearMemoryController", "args": {"target_ratio": 0.75, "max_mem_ratio_start": 0.25}},
            "grad_clip": {"name": "AdaptiveGradClipper", "args": {"max_norm": 1.0, "clip_percentile": 95}},
            "i_log": 50,
            "i_sample": 1000,
            "i_save": 1000,
            "p_uncond": 0.08,
            "t_schedule": {"name": "uniform", "args": {}},
            "sigma_min": 1e-5,
            "image_cond_model": {"name": "DinoV3FeatureExtractor", "args": {"model_name": "./dinov3", "image_size": 1024}}
        }
    }
}
